-- vidow 的完整默认配置（`vidow --default-config` 打印出来的一份）
--
-- 每行都是内置默认值：整份抄到 ~/.config/vidow/config.lua 就等于什么都没改。
-- 文件里写了的键会一直盖住内置默认值 —— 想让 vidow 以后改进的默认值生效，
-- 就把那一行删掉（或者注释掉）。
--
-- 一族配置可以写成一张表，只盖其中几项，比如：
--     gaps   = 10
--     gaps   = { top = 30, inner = 20 }       -- 上边距 30、窗口之间 20、其余 6
--     border = { width = 0, color = "#2a2e3aff" }
-- 表里的项名写在下面每一节里；平铺键（gaps_inner = 20）和表写法是一回事。
--
-- 优先级：环境变量 VIDOW_<键名大写> > 这个文件 > 内置默认值。
-- 同一个键在文件里写两遍只有第一遍生效（第一遍之后它就是个普通全局变量了）。
-- 运行时改：vidowmsg set-config <键> <值>（不落盘）。
-- 改完这个文件不用重启：  kill -HUP $(pgrep -x vidow)

-- ================== 间距（gap）
-- 屏幕边到窗口、以及窗口之间的间距（一个数全管）
gaps = 6
-- 单设上边距，-1 = 跟随 gaps（其余负值当 0）
gaps_top = -1
-- 单设下边距，-1 = 跟随 gaps（其余负值当 0）
gaps_bottom = -1
-- 单设左边距，-1 = 跟随 gaps（其余负值当 0）
gaps_left = -1
-- 单设右边距，-1 = 跟随 gaps（其余负值当 0）
gaps_right = -1
-- 单设窗口之间（列与列、同列上下）的间距，-1 = 跟随 gaps（其余负值当 0）
gaps_inner = -1
-- 这一族也能写成一张表，只写要改的项（gaps = { top = -1, bottom = -1, left = -1, right = -1, inner = -1 }）
--     不写表也行：gaps = 6（一个值管全部）

-- ================== 窗口装饰
-- 圆角/边框/阴影这套装饰的总开关
decor_enabled = true
-- 让客户端别画自己的装饰（CSD）：开启后连只认 KDE 老协议的客户端（GTK3）也听得见 —— 客户端把标题栏一起收回去，窗口只剩 vidow 的边框
prefer_no_csd = false
-- 圆角半径（逻辑像素，0 = 直角）
corner_radius = 12
-- 边框宽度（0 = 不画边框）
border_width = 2
-- 未聚焦窗口的边框颜色
border_color = "#4d546bff"
-- 聚焦窗口的边框颜色
border_color_focus = "#7aa6f7ff"
-- 阴影半径（0 = 不画阴影）
shadow_radius = 8
-- 阴影颜色，alpha 管浓淡
shadow_color = "#0000008c"
-- 阴影横向偏移（像素）
shadow_offset_x = 0
-- 阴影纵向偏移（像素）
shadow_offset_y = 2
-- 窗口（含装饰）的不透明度，0.5 = 半透明
window_opacity = 1
-- 往装饰里掺的噪点强度，0 = 不加
noise = 0
-- 这一族也能写成一张表，只写要改的项（decor = { enabled = true, corner_radius = 12, opacity = 1, noise = 0 }）
--     不写表也行：decor = true（一个值管全部）
-- 这一族也能写成一张表，只写要改的项（border = { width = 2, color = "#4d546bff", color_focus = "#7aa6f7ff" }）
-- 这一族也能写成一张表，只写要改的项（shadow = { radius = 8, color = "#0000008c", offset_x = 0, offset_y = 2 }）

-- ================== 背景模糊
-- 背景模糊总开关
blur_enabled = true
-- 平铺窗口也模糊身后的壁纸；关掉只模糊浮动窗口后面
blur_all = true
-- Kawase 模糊的层级数，越大越糊（也更费 GPU）
blur_levels = 4
-- 模糊强度倍数
blur_strength = 1
-- 窗口内容透明度低于这个值的地方不参与模糊（省 GPU）
blur_alpha_min = 0.15
-- 模糊采样偏移，越大越散
blur_offset = 1.5
-- 这一族也能写成一张表，只写要改的项（blur = { enabled = true, all = true, levels = 4, strength = 1, alpha_min = 0.15, offset = 1.5 }）
--     不写表也行：blur = true（一个值管全部）

-- ================== 开关动画
-- 窗口打开动画时长（毫秒，0 = 不动画）
window_open_ms = 180
-- 窗口关闭动画时长
window_close_ms = 140
-- 窗口移动 / 布局重排的动画时长
window_move_ms = 190
-- layer-shell（状态栏、通知、挂件）出现的动画时长
layer_open_ms = 200
-- layer-shell 消失的动画时长
layer_close_ms = 150
-- 缓动曲线：linear / out_cubic / out_quint / in_out_cubic / out_back / out_elastic
easing = "out_cubic"
-- 打开动画的起始透明度
open_alpha_from = 0
-- 打开动画的起始位移（像素）
open_slide_px = 22
-- 关闭动画的结束透明度
close_alpha_to = 0
-- 关闭动画的结束位移（像素）
close_slide_px = 14
-- 打开动画的缓动曲线（默认 out_elastic：过冲一下再收住）
open_easing = "out_elastic"
-- 关闭动画的缓动曲线
close_easing = "out_elastic"
-- 打开动画的起始缩放（1.0 = 不缩；0.82 = 弹一下）
open_scale_from = 0.82
-- 关闭动画的结束缩放（1.0 = 不缩）
close_scale_to = 0.82
-- 这一族也能写成一张表，只写要改的项（anim = { open_ms = 180, close_ms = 140, move_ms = 190, layer_open_ms = 200, layer_close_ms = 150, easing = "out_cubic", open_alpha_from = 0, open_slide_px = 22, close_alpha_to = 0, close_slide_px = 14, open_easing = "out_elastic", close_easing = "out_elastic", open_scale_from = 0.82, close_scale_to = 0.82 }）

-- ================== 自定义着色器
-- 自定义 shader 总开关（需要 GLES2 渲染器）
shader_enabled = true
-- shader 目录，加载 <目录>/<名字>.frag
-- 默认跟着配置目录走（<配置目录>/shaders，$XDG_CONFIG_HOME/vidow/shaders 或 ~/.config/vidow/shaders）
-- shader_dir = "<配置目录>/shaders"   ← 要写死就自己换成绝对路径
-- 采样时翻转 y（自己写的 shader 上下反了才需要）
shader_flip_y = false
-- 窗口打开时用的 shader 名字，留空 = 不用
shader_open = ""
-- 窗口关闭时用的 shader 名字，留空 = 不用
shader_close = ""
-- 窗口空闲（一直开着不动画）时用的 shader 名字，留空 = 不用
shader_idle = ""
-- 这一族也能写成一张表，只写要改的项（shader = { enabled = true, dir = "<配置目录>/shaders", flip_y = false, open = "", close = "", idle = "" }）
--     不写表也行：shader = true（一个值管全部）

-- ================== 刷新与补帧
-- 滚出视口的窗口每秒补多少帧（0 = 不限），配合窗口规则的 force_render
force_render_hz = 60

-- ================== 剪贴板
-- 接管 X11(XWayland) ↔ Wayland 的剪贴板同步
clipboard = true
-- PRIMARY（选中即复制）也一起同步
clipboard_primary = true
-- 每种类型在内存里留的副本上限（字节），超了丢这个类型
clipboard_max_bytes = 33554432
-- 这一族也能写成一张表，只写要改的项（clipboard = { enabled = true, primary = true, max_bytes = 33554432 }）
--     不写表也行：clipboard = true（一个值管全部）

-- ================== IPC
-- 开 IPC socket（vidowmsg、状态栏、脚本靠它）
ipc = true
-- socket 路径，留空 = 按 WAYLAND_DISPLAY 自动取
ipc_socket = ""
-- 这一族也能写成一张表，只写要改的项（ipc = { enabled = true, socket = "" }）
--     不写表也行：ipc = true（一个值管全部）

-- ================== 缩放与输出
-- 缩放：auto = 按 EDID 的 ppi 推，也可以写死 "1" / "1.5"
scale = "auto"
-- 按输出名覆盖缩放（如 "DP-1:1.5,HDMI-A-1:1"），留空 = 用 scale
outputs = ""

-- ================== XWayland
-- 开 XWayland（有人连 X 才启动服务）
xwayland = true
-- XWayland 的缩放：auto = 所有输出里最大的那个
xwayland_scale = "auto"
-- 给客户端设 XDG_SESSION_TYPE 这类 X11 环境变量
xwayland_env = true
-- 这一族也能写成一张表，只写要改的项（xwayland = { enabled = true, scale = "auto", env = true }）
--     不写表也行：xwayland = true（一个值管全部）

-- ================== 窗口激活
-- 激活令牌多久作废（秒），0 = 不过期
activation_token_timeout = 0
-- serial 校验不过的激活请求也理（默认不理）
honor_xdg_activation_with_invalid_serial = false

-- ================== xdg-desktop-portal
-- 把 XDG_CURRENT_DESKTOP 设成下面这个名字
portal_conf_sync = true
-- XDG_CURRENT_DESKTOP 的值（xdg-desktop-portal 按它选 <名字>-portals.conf）
portal_desktop = "Vidow"
-- 这一族也能写成一张表，只写要改的项（portal = { conf_sync = true, desktop = "Vidow" }）
